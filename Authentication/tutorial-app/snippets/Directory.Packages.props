    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.21" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="9.0.21" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Certificate" Version="9.0.21" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.21" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="9.0.21" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="9.0.21" />
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.1" />
    <PackageVersion Include="Otp.NET" Version="1.4.1" />
    <PackageVersion Include="Fido2.AspNet" Version="4.3.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>
</Project>
